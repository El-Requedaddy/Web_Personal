---
import { aboutContent } from '@constants/about';
import { siteConfig, socialConfig, withBase } from '@constants/site-config';
import { Icon } from 'astro-icon/components';
import { getLocaleFromUrl, localizedPath } from '@/i18n';

const locale = getLocaleFromUrl(Astro.url.pathname);
const data = aboutContent[locale] ?? aboutContent.es;

const socialLabels: Record<string, string> = { github: 'GitHub', linkedin: 'LinkedIn', email: 'Email' };
const contacts = Object.entries(socialConfig).map(([key, cfg]) => ({
  key,
  label: socialLabels[key] ?? key,
  icon: cfg.icon,
  url: cfg.url,
}));

const projectsHref = localizedPath('/categories/projects', locale);
const aboutHref = localizedPath('/about', locale);
const cvHref = withBase(data.cvHref);
const avatar = siteConfig.avatar;
---

<section
  class="border-border bg-card/60 flex flex-col items-center gap-6 rounded-2xl border p-6 text-center backdrop-blur sm:flex-row sm:items-center sm:p-8 sm:text-left"
>
  <img
    src={avatar}
    alt={data.name}
    width="112"
    height="112"
    class="border-border size-24 shrink-0 rounded-full border-4 object-cover shadow-lg sm:size-28"
  />
  <div class="flex flex-col gap-2">
    <p class="text-muted-foreground text-sm font-medium">{data.greeting}</p>
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">{data.name}</h1>
    <p class="text-primary font-semibold">{data.role}</p>
    <p class="text-muted-foreground max-w-xl text-pretty text-sm">{data.tagline}</p>

    <div class="mt-3 flex flex-wrap items-center justify-center gap-2 sm:justify-start">
      <a
        href={projectsHref}
        class="bg-primary text-primary-foreground inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-sm font-medium shadow-sm transition-transform duration-200 hover:scale-105"
      >
        <Icon name="ri:function-fill" class="size-4" />
        {data.labels.viewProjects}
      </a>
      <a
        href={cvHref}
        download
        class="border-border bg-card hover:border-primary hover:text-primary inline-flex items-center gap-1.5 rounded-full border px-4 py-2 text-sm font-medium transition-colors duration-200"
      >
        <Icon name="ri:download-2-line" class="size-4" />
        {data.labels.downloadCv}
      </a>
      <a
        href={aboutHref}
        class="border-border bg-card hover:border-primary hover:text-primary inline-flex items-center gap-1.5 rounded-full border px-4 py-2 text-sm font-medium transition-colors duration-200"
      >
        <Icon name="fa6-regular:circle-user" class="size-4" />
        {data.labels.aboutMe}
      </a>

      <span class="bg-border mx-1 hidden h-6 w-px sm:inline-block"></span>

      {
        contacts.map((c) => (
          <a
            href={c.url}
            target={c.key === 'email' ? undefined : '_blank'}
            rel="noopener noreferrer"
            aria-label={c.label}
            title={c.label}
            class="border-border bg-card hover:border-primary hover:text-primary flex size-9 items-center justify-center rounded-full border transition-colors duration-200"
          >
            <Icon name={c.icon} class="size-4" />
          </a>
        ))
      }
    </div>
  </div>
</section>
